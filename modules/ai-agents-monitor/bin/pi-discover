#!/usr/bin/env bash
# Discovers interactive Pi instances through dotshell-agent-state PID records.
# Never infer session ownership from a working directory or file modification time.
#
# Status inference (newest 50 lines of active session):
#   - error: last assistant message has stopReason == "aborted" or
#            non-empty errorMessage, with no later user/toolResult message.
#   - busy:  last user/toolResult message is newer than the last assistant
#            message with stopReason == "stop".
#   - input: an unanswered ask_user_question or built-in pi-guardrails prompt
#            is pending, or the last assistant stop asks for input.
#   - idle:  otherwise (last assistant has stopReason == "stop", or session
#            has no messages yet).
#
# Output: one tab-separated line per instance:
#   <pid>\t<cwd>\t<sessionId>\t<status>\t<sessionTitle>
#
# Titles prefer the latest nonblank session name, then the first user text.

set -eo pipefail

state_dir="${PI_AGENT_STATE_DIR:-${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/dotshell-agent-state}"

if ! command -v jq >/dev/null 2>&1; then
  exit 0
fi

session_status() {
  tail -n 50 "$1" | tr -d '\000' | jq -rs '
    def text_content:
      [(.message.content // [])[]? | select(.type == "text") | .text] | join("\n");

    def asks_for_input:
      gsub("[[:space:]]+$"; "")
      | test("\\?$|(?im)(^|\\n)\\s*(pick|choose|select|run|proceed|continue|which|want me to|should i|shall i|ok to|okay to|approve|confirm)\\b.*\\?\\s*$");

    # ponytail: Mirrors built-ins only; use an event/state bridge for custom patterns.
    def needs_guardrail_confirmation:
      test(
        "(^|[;&|\\n][[:space:]]*)("
        + "rm[[:space:]]+(?=[^;&|\\n]*(-[^[:space:]]*[rR]|--recursive|--dir))(?=[^;&|\\n]*(-[^[:space:]]*f|--force))[^;&|\\n]*"
        + "|(?:sudo|doas|pkexec|shred|wipefs|blkdiscard|fdisk|sfdisk|cfdisk|parted|sgdisk|mkfs(?:\\.[^[:space:];|&]+)?)(?:[[:space:]]|$)"
        + "|dd[[:space:]]+(?:[^[:space:];&|]+[[:space:]]+)*of=[^;&|\\n]*"
        + "|chmod[[:space:]]+(?=[^;&|\\n]*(-R|--recursive))(?=[^;&|\\n]*(0?777|a\\+rwx|ugo\\+rwx|7777|1777))[^;&|\\n]*"
        + "|chown[[:space:]]+(?=[^;&|\\n]*(-R|--recursive))[^;&|\\n]*"
        + "|(?:docker|podman)[[:space:]]+(?:run|create)[[:space:]]+(?=[^;&|\\n]*(--privileged|--pid=host|--network=host|--userns=host|--uts=host|--ipc=host|-v/:|--volume=/:|--mount=type=bind,source=/,|docker\\.sock|podman\\.sock))[^;&|\\n]*"
        + ")";
        "i"
      );

    def guarded_tool_call:
      .type == "toolCall"
      and .name == "bash"
      and ((.arguments.command // "") | needs_guardrail_confirmation);

    reduce .[] as $e (
      {lastAssistantStop: null, lastAssistantStopText: "", lastAssistantError: null, lastInputRequest: null, lastUserOrTool: null, pendingGuardrailCalls: {}};
      if $e.type == "message" then
        if $e.message.role == "assistant" then
          (reduce ($e.message.content // [])[]? as $content (.;
            if ($content | guarded_tool_call) then
              .pendingGuardrailCalls[$content.id] = true
            else . end
          ))
          | (if ($e.message.stopReason == "stop") then
            .lastAssistantStop = $e.timestamp
            | .lastAssistantStopText = ($e | text_content)
          else . end)
          | (if ($e.message.stopReason == "aborted")
                or (($e.message.errorMessage // "") != "") then
            .lastAssistantError = $e.timestamp
          else . end)
          | (if any($e.message.content[]?; .type == "toolCall" and .name == "ask_user_question") then
            .lastInputRequest = $e.timestamp
          else . end)
        elif ($e.message.role == "user") or ($e.message.role == "toolResult") then
          .lastUserOrTool = $e.timestamp
          | if $e.message.role == "toolResult" and (($e.message.toolCallId // "") != "") then
              del(.pendingGuardrailCalls[$e.message.toolCallId])
            else . end
        else . end
      else . end
    )
    | if (.pendingGuardrailCalls | length) > 0
      then "input"
      elif (.lastAssistantError != null)
        and ((.lastUserOrTool == null) or (.lastUserOrTool < .lastAssistantError))
      then "error"
      elif (.lastInputRequest != null)
        and ((.lastUserOrTool == null) or (.lastUserOrTool < .lastInputRequest))
      then "input"
      elif (.lastUserOrTool != null)
        and ((.lastAssistantStop == null) or (.lastUserOrTool > .lastAssistantStop))
      then "busy"
      elif (.lastAssistantStop != null)
        and ((.lastUserOrTool == null) or (.lastAssistantStop > .lastUserOrTool))
        and (.lastAssistantStopText | asks_for_input)
      then "input"
      else "idle"
      end
  '
}

if [ "${1:-}" = "--status-file" ]; then
  [ "$#" -eq 2 ] || exit 2
  session_status "$2"
  exit
fi

# Read field 22 after comm, whose parenthesized value may contain spaces or ')'.
process_start_ticks() {
  local stat
  local -a fields
  stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  read -r -a fields <<<"${stat##*) }"
  [[ "${fields[19]:-}" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "${fields[19]}"
}

# Replace tabs/newlines with spaces and collapse whitespace without clipping names.
normalise_title() {
  local raw="$1"
  raw="${raw//$'\t'/ }"
  raw="${raw//$'\n'/ }"
  raw="${raw//$'\r'/ }"
  # Collapse runs of whitespace
  raw=$(printf '%s' "$raw" | tr -s ' ')
  # Trim leading/trailing space
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  printf '%s' "$raw"
}

boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || exit 0

while read -r pid; do
  [[ "$pid" =~ ^[0-9]+$ ]] || continue
  stdin=$(readlink "/proc/$pid/fd/0" 2>/dev/null) || continue
  [[ "$stdin" == /dev/pts/* || "$stdin" == /dev/tty* ]] || continue
  start_ticks=$(process_start_ticks "$pid") || continue
  cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
  [ -n "$cwd" ] || continue

  [ -f "$state_dir/$pid.json" ] || continue
  record=$(jq -cse --argjson pid "$pid" --arg ticks "$start_ticks" --arg boot "$boot_id" '
    select(length == 1) | .[0]
    | select(type == "object" and .version == 1 and .pid == $pid
      and .startTicks == $ticks and .bootId == $boot)
    | select((.sessionId | type) == "string")
    | select(.sessionId | length > 0 and (test("[[:cntrl:]]") | not))
    | select(has("sessionFile"))
    | select(.sessionFile == null or
      (.sessionFile | type == "string" and startswith("/") and (test("[[:cntrl:]]") | not)))
  ' "$state_dir/$pid.json" 2>/dev/null) || continue
  session_id=$(jq -r '.sessionId' <<<"$record")
  active_file=$(jq -r '.sessionFile // ""' <<<"$record")

  if [ -z "$active_file" ]; then
    printf '%s\t%s\t%s\tidle\t\n' "$pid" "$cwd" "$session_id"
    continue
  fi

  # Missing (including not yet flushed) files are omitted until their header exists.
  [ -f "$active_file" ] || continue
  head -n 1 "$active_file" | jq -e --arg id "$session_id" \
    'type == "object" and .type == "session" and .id == $id' >/dev/null 2>&1 || continue

  # Status inference from the tail
  status=$(session_status "$active_file" 2>/dev/null || echo "idle")

  [ -n "$status" ] || status="idle"

  # Prefer the latest manual session name; fall back to the first user-text message
  raw_title=$(jq -rs '
    ([ .[]
      | select(.type == "session_info")
      | (.name // "" | strings | gsub("^[[:space:]]+|[[:space:]]+$"; ""))
      | select(. != "")
    ] | last) // ""
  ' "$active_file" 2>/dev/null || echo "")

  title=$(normalise_title "$raw_title")
  if [ -z "$title" ]; then
    raw_title=$(jq -rs '
      [ .[]
        | select(.type == "message" and .message.role == "user")
        | (.message.content // [])[]?
        | select(.type == "text")
        | .text
      ] | (.[0] // "")
    ' "$active_file" 2>/dev/null || echo "")
    title=$(normalise_title "$raw_title")
    # Keep prompt previews short; only explicit session names are unbounded.
    if [ "${#title}" -gt 80 ]; then title="${title:0:77}..."; fi
  fi

  printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$cwd" "$session_id" "$status" "$title"
done < <(pgrep -x pi 2>/dev/null || true)
