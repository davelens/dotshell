[Unit]
Description=dotshell desktop shell
Documentation=https://quickshell.outfoxxed.me
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=QSG_RHI_BACKEND=vulkan
ExecStart=/usr/bin/quickshell -p %h/.config/dotshell
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
